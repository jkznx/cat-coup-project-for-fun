      "html": "<nav class=\"ds-nav\"><a class=\"ds-brand\" href=\"#cat-coup\">Cat Coup<span>•</span></a><button class=\"ds-rules\">How to play</button></nav>",
      "css": ".ds-nav{font-family:Geist,Arial,sans-serif;font-size:14px;display:flex;align-items:center;justify-content:space-between;height:100px;gap:24px;border-bottom:1px solid var(--line,#3c5359);color:var(--ink,#f5eee0)}.ds-brand{font-size:24px;font-weight:800;letter-spacing:-.04em;color:inherit;text-decoration:none}.ds-brand span{color:var(--gold,#e8b86d)}.ds-rules{font-family:Geist,Arial,sans-serif;font-size:14px;border:1px solid var(--line,#3c5359);border-radius:9px;padding:16px 24px;color:inherit;background:transparent;min-height:44px;font-weight:600;cursor:pointer;transition:background .2s}.ds-rules:hover{background:var(--surface,#1e3540)}.ds-rules:focus-visible{outline:3px solid var(--gold,#e8b86d);outline-offset:4px}.ds-brand:focus-visible{outline:3px solid var(--gold,#e8b86d);outline-offset:4px}@media(max-width:700px){.ds-nav{height:80px}.ds-brand{font-size:21px}}@media(prefers-reduced-motion:reduce){.ds-rules{transition:none}}"
