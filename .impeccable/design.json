  "narrative": {
    "northStar": "Midnight Cat Lounge",
    "overview": "A cozy table for playful deception: deep navy felt supports warm original cat portraits, amber actions, and pale readable text. The atmosphere is intimate and tactile, while the controls remain direct enough for fast multiplayer decisions.\n\nGeist carries both expressive headlines and compact game information. Tonal panels organize the table; the warm paper of influence cards distinguishes physical objects from interface controls. Cat characters replace human characters as a durable brand commitment.\n\nVintage adds a room-scoped **Printed Storybook Court** variant. The default system below remains the Classic Midnight Cat Lounge: selecting Vintage changes the surrounding paper, ink, type and controls, while the original five painted cat portraits remain unchanged. Merchant, Bandit and Guardian use a matching painted three-panel sprite, not the former flat vector portraits. Rules, hidden-card semantics and opt-in hold-to-talk remain independent of this skin.",
    "keyCharacteristics": [
      "Midnight navy table with amber-gold actions and sage secondary controls.",
      "Warm illustrated cats framed as pale physical cards.",
      "Compact, readable game controls with explicit selection and turn states.",
      "Brief arrival motion that respects reduced-motion preferences.",
      "Vintage rooms use warm paper, ink outlines, Bree Serif headings and a painted eight-cat cast; Classic remains Midnight Cat Lounge."
    ],
    "rules": [
      {
        "name": "The Amber Signal Rule",
        "body": "Use amber for actionable emphasis and meaningful game state; pair it with labels, borders, or selection outlines so state remains understandable.",
        "section": "colors"
      },
      {
        "name": "The Table Depth Rule",
        "body": "Use tonal panels and borders for game organization; reserve the stronger existing shadow for physical influence cards.",
        "section": "elevation"
      },
      {
        "name": "The Room Skin Rule",
        "body": "Apply Vintage tokens only inside a Vintage room; switching to Classic restores the incumbent dark palette and Geist display voice.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain the Midnight Cat Lounge palette for Classic and warm original cat artwork in both modes.",
      "Do mark turns, selections, and available responses with readable text and visible state treatments.",
      "Do preserve the responsive opponent, decision, hand, and action hierarchy.",
      "Do honor reduced motion in both CSS and GSAP.",
      "Do keep keyboard focus visible with the shared amber outline in Classic and the teal outline in Vintage.",
      "Do apply the Vintage paper/ink variant only to Vintage rooms and preserve the original five painted portraits."
    ],
    "donts": [
      "Don't make another player's hidden influence visually inspectable.",
      "Don't rely on animation completion to unlock a game action.",
      "Don't replace cat portraits with unrelated human character imagery.",
      "Don't flatten selected, revealed, disabled, and active-turn states into the same treatment.",
      "Don't substitute flat geometric portraits for the painted Vintage cast or apply its serif headings to Classic."
    ]
  }
}
