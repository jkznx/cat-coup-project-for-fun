      "css": ".ds-label{font-family:Geist,Arial,sans-serif;font-size:14px;display:grid;gap:8px;color:var(--ink,#f5eee0);font-size:13px;font-weight:600}.ds-field{font-family:Geist,Arial,sans-serif;font-size:14px;background:#12242c;color:var(--ink,#f5eee0);border:1px solid #60757a;border-radius:8px;padding:16px 16px;min-height:48px;caret-color:var(--gold,#e8b86d)}.ds-field::placeholder{color:#a0b6b9}.ds-field:focus-visible{outline:3px solid var(--gold,#e8b86d);outline-offset:4px}"
