      "html": "<button class=\"ds-danger\">Leave room</button>",
      "css": ".ds-danger{font-family:Geist,Arial,sans-serif;font-size:14px;background:#663a3b;color:#fff3ed;border:1px solid #be7c76;border-radius:9px;padding:16px 24px;font-weight:600;min-height:44px;cursor:pointer;transition:background .2s,transform .2s}.ds-danger:hover:not(:disabled){background:#663a3b;transform:translateY(-2px)}.ds-danger:focus-visible{outline:3px solid var(--gold,#e8b86d);outline-offset:4px}.ds-danger:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none}.ds-danger:hover:not(:disabled){transform:none}}"
