  "narrative": {
    "northStar": "Midnight Cat Lounge",
    "overview": "A cozy table for playful deception: deep navy felt supports warm original cat portraits, amber actions, and pale readable text. The atmosphere is intimate and tactile, while the controls remain direct enough for fast multiplayer decisions.\n\nGeist carries both expressive headlines and compact game information. Tonal panels organize the table; the warm paper of influence cards distinguishes physical objects from interface controls. Cat characters replace human characters as a durable brand commitment.",
    "keyCharacteristics": [
      "Midnight navy table with amber-gold actions and sage secondary controls.",
      "Warm illustrated cats framed as pale physical cards.",
      "Compact, readable game controls with explicit selection and turn states.",
      "Brief arrival motion that respects reduced-motion preferences."
    ],
    "rules": [
      {
        "name": "The Amber Signal Rule",
        "body": "Use amber for actionable emphasis and meaningful game state; pair it with labels, borders, or selection outlines so state remains understandable.",
        "section": "colors"
      },
      {
        "name": "The Table Depth Rule",
        "body": "Use tonal panels and borders for game organization; reserve the stronger existing shadow for physical influence cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the Midnight Cat Lounge palette and warm original cat artwork.",
      "Do mark turns, selections, and available responses with readable text and visible state treatments.",
      "Do preserve the responsive opponent, decision, hand, and action hierarchy.",
      "Do honor reduced motion in both CSS and GSAP.",
      "Do keep keyboard focus visible with the shared amber outline."
    ],
    "donts": [
      "Don't make another player's hidden influence visually inspectable.",
      "Don't rely on animation completion to unlock a game action.",
      "Don't replace cat portraits with unrelated human character imagery.",
      "Don't flatten selected, revealed, disabled, and active-turn states into the same treatment."
    ]
  }
}
